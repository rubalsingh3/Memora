MEMORA_ENV=development

# Providers
MAIN_LLM_PROVIDER=ollama
MAIN_LLM_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_LLM_MODEL=gpt-oss:20b
OLLAMA_REASONING_EFFORT=low
MEMORA_ANALYZER_MODEL=gemini-2.5-flash

# Server-side keys (never commit real values)
GEMINI_API_KEY=
GOOGLE_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# CORS & Timeouts
MEMORA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MEMORA_TIMEOUT_MS=45000
MEMORA_MAX_REQUEST_BYTES=262144
MEMORA_MAX_SESSIONS=500

# Progress Memory (default OFF in initial build)
PROGRESS_MEMORY_ENABLED=false
PROGRESS_MEMORY_MAX_ENTRIES=48

